#!/bin/sh
# mkiso: the Chamesle live ISO, with mag putting chamesle-base, the kernel and profile/packages in its root.
#   mkiso -o chamesle.iso
#   mkiso -a x86 -o chamesle-x86.iso
# MAG is the mag to build with (default: the one in PATH), REPOS a repos file to build from instead of chamesle-base's
set -e
here=$(cd "$(dirname "$0")" && pwd)
profile=$here/profile
work=$PWD/work
out=chamesle.iso
arch=x86_64
while getopts a:p:w:o: o; do
	case $o in
	a) arch=$OPTARG;;
	p) profile=$OPTARG;;
	w) work=$OPTARG;;
	o) out=$OPTARG;;
	*) echo "usage: mkiso [-a arch] [-p profile] [-w workdir] [-o out.iso]" >&2; exit 2;;
	esac
done
: "${MKISOFS:=xorriso -as mkisofs}"
die() { echo "mkiso: $*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "run it as root, the files of the image belong to root"
[ -n "$MAG" ] || MAG=$(command -v mag) || die "no mag: put it in PATH or set MAG"
for t in mksquashfs ${MKISOFS%% *} zstd bsdcpio; do command -v $t >/dev/null || die "$t is not installed"; done

iso=$work/iso rootfs=$work/rootfs
rm -rf "$iso" "$rootfs"
mkdir -p "$iso/boot/limine" "$iso/EFI/BOOT" "$iso/LiveOS" "$rootfs/etc/mag"
cp "${REPOS:-$here/../pkg/chamesle-base/repos}" "$rootfs/etc/mag/repos"
cp -R "$here/../keys" "$rootfs/etc/mag/keys"
echo "$arch" > "$rootfs/etc/mag/arch"
# CACHE is a directory to keep the downloaded packages in between builds
[ -z "$CACHE" ] || { mkdir -p "$CACHE" "$rootfs/var/cache/mag"; cp -R "$CACHE" "$rootfs/var/cache/mag/pkg"; }
MAG_ROOT=$rootfs "$MAG" update
MAG_ROOT=$rootfs "$MAG" install chamesle-base linux-lts $(grep -v '^#' "$profile/packages")
[ -z "$CACHE" ] || cp "$rootfs"/var/cache/mag/pkg/* "$CACHE/"
cp "$here/../pkg/chamesle-base/repos" "$rootfs/etc/mag/repos"
tar -C "$profile/overlay" -cf - . | tar -C "$rootfs" -xf -
rm -rf "$rootfs"/var/cache/mag/pkg "$rootfs"/var/tmp/mag "$rootfs"/boot/initramfs-*

kver=$(ls "$rootfs/lib/modules" | head -n 1)
[ -f "$rootfs/boot/vmlinuz-lts" ] && [ -n "$kver" ] || die "no kernel in the root"
cp "$rootfs/boot/vmlinuz-lts" "$iso/boot/vmlinuz"
"$here/mkinitramfs" -m "$profile/modules" "$rootfs" "$kver" "$iso/boot/initrd"

mksquashfs "$rootfs" "$iso/LiveOS/rootfs.sfs" -comp zstd -Xcompression-level 19 -b 256K -noappend -no-progress >/dev/null

LIMINE=$rootfs/usr/share/limine
cp "$LIMINE"/limine-bios.sys "$LIMINE"/limine-bios-cd.bin "$LIMINE"/limine-uefi-cd.bin "$iso/boot/limine/"
cp "$LIMINE"/BOOTX64.EFI "$iso/EFI/BOOT/"
cp "$profile/limine.conf" "$iso/boot/limine/limine.conf"

$MKISOFS -R -r -J -V CHAMESLE \
	-b boot/limine/limine-bios-cd.bin -no-emul-boot -boot-load-size 4 -boot-info-table \
	--efi-boot boot/limine/limine-uefi-cd.bin -efi-boot-part --efi-boot-image --protective-msdos-label \
	-o "$out" "$iso" >/dev/null 2>&1 || die "$MKISOFS failed"
# the root's limine, so its stages match the limine-bios.sys on the ISO, run with the root's own musl
"$rootfs"/lib/ld-musl-*.so.1 --library-path "$rootfs/lib:$rootfs/usr/lib" "$rootfs/usr/bin/limine" bios-install "$out" >/dev/null
echo "$out: $(du -h "$out" | cut -f1)"
