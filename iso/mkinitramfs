#!/bin/sh
# mkinitramfs [-m modules-file] ROOTFS KVER OUT: a cpio of the few tools init needs, the modules named in the
# modules file with what they depend on, and init itself. the names after a [zfs] line are loaded only for root=ZFS=,
# and zpool goes in when the root has it.
set -e
here=$(cd "$(dirname "$0")" && pwd)
while getopts m: o; do case $o in m) list=$OPTARG;; *) exit 2;; esac; done
shift $((OPTIND - 1))
[ $# = 3 ] || { echo "usage: mkinitramfs [-m modules] ROOTFS KVER OUT" >&2; exit 2; }
root=$1 kver=$2 out=$3
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp"/bin "$tmp"/dev "$tmp"/proc "$tmp"/sys "$tmp"/run "$tmp"/mnt "$tmp"/lib/modules
rd=$(command -v llvm-readelf || command -v readelf) || { echo "mkinitramfs: no readelf" >&2; exit 1; }
# a path in the root with its links followed inside the root, since a link there may point at /bin/busybox
inroot() {
	f=$1
	while [ -L "$f" ]; do
		l=$(readlink "$f")
		case $l in /*) f=$root$l;; *) f=${f%/*}/$l;; esac
	done
	echo "$f"
}
# a readelf that does not run copies no libraries, and an init that cannot mount /proc
"$rd" -h "$(inroot "$root/bin/busybox")" >/dev/null 2>&1 || { echo "mkinitramfs: $rd does not work" >&2; exit 1; }
# copy what a binary links against: the musl loader and every NEEDED library found in the root
needed() {
	$rd -d "$1" | sed -n 's/.*(NEEDED).*\[\(.*\)\]/\1/p' | while read -r l; do
		[ -e "$tmp/usr/lib/$l" ] && continue
		for d in usr/lib lib; do
			[ -e "$root/$d/$l" ] || [ -L "$root/$d/$l" ] || continue
			mkdir -p "$tmp/usr/lib"
			cp "$(inroot "$root/$d/$l")" "$tmp/usr/lib/$l"
			needed "$(inroot "$root/$d/$l")"
			break
		done
	done
}
mkdir -p "$tmp/lib" "$tmp/usr/lib"
for l in "$root"/lib/ld-musl-*.so.1; do cp "$(inroot "$l")" "$tmp/lib/${l##*/}"; done
for t in sh mount umount switch_root insmod mkdir sleep blkid; do
	f=
	for d in usr/bin bin usr/sbin sbin; do
		[ -e "$root/$d/$t" ] || [ -L "$root/$d/$t" ] || continue
		f=$(inroot "$root/$d/$t")
		[ -x "$f" ] && break
		f=
	done
	[ -n "$f" ] || { echo "mkinitramfs: no $t in $root" >&2; exit 1; }
	cp "$f" "$tmp/bin/$t"
	needed "$f"
done
# modules FILE: copies the modules named on stdin with what they depend on and lists their paths in FILE
modules() {
	while read -r m; do
		[ -n "$m" ] || continue
		modprobe -d "$root" -S "$kver" --show-depends "$m" 2>/dev/null | sed -n 's/^insmod //p'
	done | awk '!seen[$0]++' | while read -r ko; do
		ko=${ko#$root}
		mkdir -p "$tmp$(dirname "$ko")"
		cp "$root$ko" "$tmp$ko"
		echo "$ko" >> "$1"
	done
}
: > "$tmp/modules"
: > "$tmp/modules.zfs"
if [ -n "$list" ]; then
	grep -v '^#' "$list" | sed -n '/^\[zfs\]/q;p' | modules "$tmp/modules"
	sed -n '/^\[zfs\]/,$p' "$list" | grep -v '^#\|^\[' | modules "$tmp/modules.zfs"
fi
for d in usr/sbin sbin usr/bin bin; do
	[ -x "$root/$d/zpool" ] || continue
	cp "$(inroot "$root/$d/zpool")" "$tmp/bin/zpool"
	needed "$root/$d/zpool"
	break
done
cp "$here/init" "$tmp/init"
chmod 755 "$tmp/init"
(cd "$tmp" && find . | bsdcpio -o -H newc 2>/dev/null) | zstd -19 -q -o "$out" -f
