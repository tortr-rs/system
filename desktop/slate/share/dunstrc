[global]
    font = Nimbus Sans 10
    origin = top-left
    offset = (8, 8)
    width = 320
    frame_width = 1
    frame_color = "#000000"
    separator_color = frame
    padding = 8
    horizontal_padding = 10
    corner_radius = 0
    format = "<b>%s</b>\n%b"
    icon_position = left
    max_icon_size = 32

[urgency_low]
    background = "#aaaaaa"
    foreground = "#000000"
    timeout = 5

[urgency_normal]
    background = "#aaaaaa"
    foreground = "#000000"
    timeout = 8

[urgency_critical]
    background = "#000000"
    foreground = "#ffffff"
    frame_color = "#ffffff"
    timeout = 0
