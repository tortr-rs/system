# what a script in /etc/services uses: set procname, define svc_start (and svc_stop, svc_status if the
# defaults do not fit), then call run "$1"
name=${0##*/}

log() { echo "$name: $*"; }

pids() {
	for _d in /proc/[0-9]*; do
		read -r _c 2>/dev/null < $_d/comm && [ "$_c" = "${1:0:15}" ] && echo ${_d#/proc/}
	done
}

running() { [ -n "$procname" ] && [ -n "$(pids $procname)" ]; }

svc_stop() {
	running || return 0
	kill $(pids $procname)
	_n=0
	while running && [ $_n -lt 10 ]; do sleep 1; _n=$((_n + 1)); done
}

svc_status() {
	[ -n "$procname" ] || { log "nothing to report"; return 0; }
	if running; then log "running as pid $(pids $procname)"; else log "not running"; return 1; fi
}

run() {
	case $1 in
	start) if running; then log "already running"; else svc_start; fi;;
	stop) svc_stop;;
	restart) svc_stop; svc_start;;
	status) svc_status;;
	*) echo "usage: $0 start|stop|restart|status" >&2; exit 2;;
	esac
}
