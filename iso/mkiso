#!/bin/sh
# mkiso: builds the Chamesle live ISO from a profile.
#   mkiso -r $HOME/src/mag/repo:/usr/pkgsrc
#   mkiso -R /srv/rootfs -o chamesle.iso
#   MAGREPO=$HOME/src/mag/repo mkiso ...  the recipes the image carries for mag search and info
set -e
here=$(cd "$(dirname "$0")" && pwd)
profile=$here/profile
work=$PWD/work
out=chamesle.iso
while getopts p:r:R:w:o: o; do
	case $o in
	p) profile=$OPTARG;;
	r) MAG_REPO=$OPTARG;;
	R) rootfs=$OPTARG;;
	w) work=$OPTARG;;
	o) out=$OPTARG;;
	*) echo "usage: mkiso [-p profile] [-r repos] [-R rootfs] [-w workdir] [-o out.iso]" >&2; exit 2;;
	esac
done
export MAG_REPO
if [ -z "$MAGREPO" ]; then
	for d in "$here/../../mag/repo" $(echo "$MAG_REPO" | tr : ' '); do
		[ -f "$d/PROVIDES" ] && { MAGREPO=$d; break; }
	done
fi
: "${MKISOFS:=xorriso -as mkisofs}"
: "${LIMINE:=/usr/share/limine}"
die() { echo "mkiso: $*" >&2; exit 1; }
[ -d "$LIMINE" ] && [ -f "$LIMINE/limine-bios-cd.bin" ] || die "no limine files in $LIMINE (set LIMINE)"
for t in mksquashfs ${MKISOFS%% *} zstd bsdcpio limine; do command -v $t >/dev/null || die "$t is not installed"; done

iso=$work/iso
mkdir -p "$work"
rm -rf "$iso"
mkdir -p "$iso/boot/limine" "$iso/EFI/BOOT" "$iso/LiveOS"

if [ -z "$rootfs" ]; then
	rootfs=$work/rootfs
	rm -rf "$rootfs"
	"$here/../tools/chamesle-bootstrap" -s "$(grep -v '^#' "$profile/packages" | tr '\n' ' ')" -n chamesle-live "$rootfs"
else
	from=$rootfs
	rm -rf "$work/rootfs"
	cp -a "$rootfs" "$work/rootfs"
	rootfs=$work/rootfs
fi
[ -n "$MAG" ] || MAG=$(command -v mag) || die "no mag: put it in PATH or set MAG"
MAG_ROOT=$rootfs MAG_PREFIX=/usr "$MAG" relocate ${from:+"$from"}

rm -rf "$rootfs"/var/cache/mag "$rootfs"/var/tmp/mag "$rootfs"/usr/include "$rootfs"/usr/lib/pkgconfig "$rootfs"/lib/firmware
find "$rootfs"/usr/lib -name "*.a" -o -name "*.la" | xargs rm -f
tar -C "$profile/overlay" -cf - . | tar -C "$rootfs" -xf -
for t in chamesle-bootstrap chamesle-chroot chamesle-disk; do
	install -Dm755 "$here/../tools/$t" "$rootfs/usr/bin/$t"
done
if [ -n "$MAGREPO" ]; then
	mkdir -p "$rootfs/usr/share/mag/repo"
	cp -R "$MAGREPO/." "$rootfs/usr/share/mag/repo/"
fi
install -Dm644 "$here/../handbook/handbook.md" "$rootfs/usr/share/doc/chamesle/handbook.md"
install -Dm755 "$MAG" "$rootfs/usr/bin/mag"
vmlinuz=$(ls "$rootfs"/boot/vmlinuz-* | head -n 1)
kver=$(ls "$rootfs/lib/modules" | head -n 1)
[ -f "$vmlinuz" ] && [ -n "$kver" ] || die "no kernel in the root: boot/vmlinuz-* and lib/modules/* are missing"
cp "$vmlinuz" "$iso/boot/vmlinuz"

depmod -b "$rootfs" "$kver"
"$here/mkinitramfs" -m "$profile/modules" "$rootfs" "$kver" "$iso/boot/initrd"

rm -f "$iso/LiveOS/rootfs.sfs"
mksquashfs "$rootfs" "$iso/LiveOS/rootfs.sfs" -comp zstd -Xcompression-level 19 -b 256K -noappend -no-progress >/dev/null

cp "$LIMINE"/limine-bios.sys "$LIMINE"/limine-bios-cd.bin "$LIMINE"/limine-uefi-cd.bin "$iso/boot/limine/"
cp "$LIMINE"/BOOTX64.EFI "$iso/EFI/BOOT/"
cp "$profile/limine.conf" "$iso/boot/limine/limine.conf"

$MKISOFS -R -r -J -V CHAMESLE \
	-b boot/limine/limine-bios-cd.bin -no-emul-boot -boot-load-size 4 -boot-info-table \
	--efi-boot boot/limine/limine-uefi-cd.bin -efi-boot-part --efi-boot-image --protective-msdos-label \
	-o "$out" "$iso" >/dev/null 2>&1 || { echo "mkiso: $MKISOFS failed" >&2; exit 1; }
limine bios-install "$out" >/dev/null
echo "$out: $(du -h "$out" | cut -f1)"
