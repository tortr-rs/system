#!/bin/sh
# chamesle-boot [DIR]: makes the system in DIR (/mnt) bootable. writes /boot/limine.conf from what is mounted there,
# installs limine into it and puts limine on the disk for UEFI, and for BIOS when the disk has room for it.
# if /boot is not FAT, limine cannot read it, so it prints an entry for the GRUB of the other system instead.
#   chamesle-boot
#   chamesle-boot /mnt
die() { echo "chamesle-boot: $*" >&2; exit 1; }
[ $# -le 1 ] || { echo "usage: chamesle-boot [DIR]" >&2; exit 2; }
[ "$(id -u)" = 0 ] || die "needs root"
t=${1:-/mnt}
t=${t%/}
[ -x "$t/sbin/init" ] || die "$t has no system in it, run chamesle-bootstrap first"

mnt() { awk -v m="$1" '$2 == m { print $1, $3 }' /proc/mounts | tail -1; }
set -- $(mnt "$t")
[ $# = 2 ] || die "nothing is mounted on $t"
rootdev=$1 rootfs=$2
set -- $(mnt "$t/boot")
bootdev=$1 bootfs=$2

kernels=
for k in "$t"/boot/vmlinuz-*; do [ -e "$k" ] && kernels="$kernels ${k##*/vmlinuz-}"; done
[ -n "$kernels" ] || die "no kernel in $t/boot, install linux-lts first"

if [ "$rootfs" = zfs ]; then
	cmdline="root=ZFS=$rootdev rootfstype=zfs"
	conf=$t/etc/mkinitfs/mkinitfs.conf
	if ! grep -q '^features=.*zfs' "$conf"; then
		echo "adding zfs to the initramfs"
		arch-chroot "$t" mag install zfs $(for k in $kernels; do echo zfs-$k; done) || die "mag install zfs failed"
		sed -i '/^features=/s/"$/ zfs"/' "$conf"
		for m in "$t"/lib/modules/*; do arch-chroot "$t" mkinitfs "${m##*/}" || die "mkinitfs failed"; done
	fi
else
	uuid=$(blkid -s UUID -o value "$rootdev") || die "no UUID for $rootdev"
	cmdline="root=UUID=$uuid modules=sd-mod,usb-storage,nvme,$rootfs rootfstype=$rootfs"
fi

if [ "$bootfs" != vfat ]; then
	[ -n "$bootdev" ] && where="$bootdev" || where="$rootdev"
	echo "/boot is not FAT, so limine cannot boot it. For the GRUB of the system already on the machine, in its"
	echo "/etc/grub.d/40_custom, then grub-mkconfig -o /boot/grub/grub.cfg:"
	echo
	p=/boot
	[ -n "$bootdev" ] && p=
	for k in $kernels; do
		cat <<G
menuentry 'Chamesle ($k)' {
	search --no-floppy --fs-uuid --set=root $(blkid -s UUID -o value "$where")
	linux $p/vmlinuz-$k $cmdline quiet
	initrd $p/initramfs-$k
}
G
	done
	exit 0
fi

[ -e "$t/usr/share/limine/limine-bios.sys" ] || arch-chroot "$t" mag install limine || die "mag install limine failed"

c=$t/boot/limine.conf
[ -e "$c" ] && mv "$c" "$c.old" && echo "the old limine.conf is limine.conf.old"
{
	echo "timeout: 3"
	for k in $kernels; do
		printf '\n/Chamesle (%s)\n    protocol: linux\n    path: boot():/vmlinuz-%s\n' "$k" "$k"
		printf '    module_path: boot():/initramfs-%s\n    cmdline: %s quiet\n' "$k" "$cmdline"
	done
} > "$c"
cat "$c"
echo

mkdir -p "$t/boot/EFI/BOOT"
for e in BOOTX64.EFI BOOTIA32.EFI; do [ -e "$t/usr/share/limine/$e" ] && cp "$t/usr/share/limine/$e" "$t/boot/EFI/BOOT/"; done
echo "UEFI: EFI/BOOT on $bootdev"

cp "$t/usr/share/limine/limine-bios.sys" "$t/boot/"
disk=/dev/$(lsblk -no PKNAME "$bootdev" | head -1)
if [ "$(lsblk -dno PTTYPE "$disk")" = gpt ] && ! lsblk -no PARTTYPE "$disk" | grep -qi 21686148-6449-6e6f-744e-656564454649; then
	echo "BIOS: $disk is GPT with no BIOS boot partition, so it boots by UEFI only"
else
	arch-chroot "$t" limine bios-install "$disk" >/dev/null || die "limine bios-install $disk failed"
	echo "BIOS: limine is on $disk"
fi
