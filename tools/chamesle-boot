#!/bin/sh
# chamesle-boot [-b limine|grub] [DIR]: makes the system in DIR (/mnt) bootable. writes the boot entries from what is
# mounted there, installs the bootloader (limine unless -b grub) into it and puts it on the disk for UEFI, and for BIOS
# when the disk has room for it. if /boot is not FAT, it prints an entry for the GRUB of the other system instead.
#   chamesle-boot
#   chamesle-boot -b grub /mnt
die() { echo "chamesle-boot: $*" >&2; exit 1; }
usage() { echo "usage: chamesle-boot [-b limine|grub] [DIR]" >&2; exit 2; }
loader=limine
export MAG_YES=1
while getopts b: o; do
	case $o in
	b) loader=$OPTARG;;
	*) usage;;
	esac
done
shift $((OPTIND - 1))
case $loader in limine|grub) ;; *) die "-b is limine or grub";; esac
[ $# -le 1 ] || usage
[ "$(id -u)" = 0 ] || die "needs root"
t=${1:-/mnt}
t=${t%/}
# / is the running system: mounts and paths go by "/"
top=${t:-/}
[ -x "$t/sbin/init" ] || die "$t has no system in it, run chamesle-bootstrap first"

inroot() { if [ -z "$t" ]; then "$@"; else arch-chroot "$t" "$@"; fi; }
mnt() { awk -v m="$1" '$2 == m { print $1, $3, $4 }' /proc/mounts | tail -1; }
set -- $(mnt "$top")
[ $# = 3 ] || die "nothing is mounted on $top"
rootdev=$1 rootfs=$2 rootopts=$3
set -- $(mnt "$t/boot")
bootdev=$1 bootfs=$2

# the glibc Chamesle is Artix underneath: mkinitcpio makes initramfs-linux.img, and grub is one package
glibc=
[ -e "$t/usr/lib/libc.so.6" ] && glibc=1
kernels=
for k in "$t"/boot/vmlinuz-*; do [ -e "$k" ] && kernels="$kernels ${k##*/vmlinuz-}"; done
[ -n "$kernels" ] || die "no kernel in $t/boot, install a kernel first (linux-lts)"
img() { [ -e "$t/boot/initramfs-$1.img" ] && echo "initramfs-$1.img" || echo "initramfs-$1"; }

# feature NAME PACKAGE...: puts NAME in the initramfs, with the packages it needs
feature() {
	if [ -n "$glibc" ]; then
		shift
		inroot mag install "$@" || die "mag install $* failed"
		return
	fi
	conf=$t/etc/mkinitfs/mkinitfs.conf
	grep -qE "^features=\"([^\"]* )?$1( |\")" "$conf" && return
	echo "adding $1 to the initramfs"
	f=$1
	shift
	inroot mag install "$@" || die "mag install $* failed"
	sed -i "/^features=/s/\"\$/ $f\"/" "$conf"
	for m in "$t"/lib/modules/*; do inroot mkinitfs "${m##*/}" || die "mkinitfs failed"; done
}

if [ "$rootfs" = zfs ] && [ -n "$glibc" ]; then
	die "the glibc Chamesle has no ZFS: neither Artix nor Arch carries it"
elif [ "$rootfs" = zfs ]; then
	cmdline="root=ZFS=$rootdev rootfstype=zfs"
	feature zfs zfs zfs-openrc $(for k in $kernels; do echo zfs-$k; done)
	for s in zfs-import zfs-mount; do [ -e "$t/etc/runlevels/sysinit/$s" ] || ln -s /etc/init.d/$s "$t/etc/runlevels/sysinit/$s"; done
else
	uuid=$(blkid -s UUID -o value "$rootdev") || die "no UUID for $rootdev"
	cmdline="root=UUID=$uuid modules=sd-mod,usb-storage,nvme,$rootfs rootfstype=$rootfs"
	[ -n "$glibc" ] && cmdline="root=UUID=$uuid rw rootfstype=$rootfs"
	if [ "$rootfs" = btrfs ]; then
		sub=$(echo "$rootopts" | tr , '\n' | sed -n 's|^subvol=/*||p')
		[ -n "$sub" ] && cmdline="$cmdline rootflags=subvol=$sub"
		feature btrfs btrfs-progs
	fi
fi

if [ "$bootfs" != vfat ]; then
	[ -n "$bootdev" ] && where="$bootdev" || where="$rootdev"
	echo "/boot is not FAT, so limine cannot boot it. For the GRUB of the system already on the machine, in its"
	echo "/etc/grub.d/40_custom, then grub-mkconfig -o /boot/grub/grub.cfg:"
	echo
	p=/boot
	[ -n "$bootdev" ] && p=
	for k in $kernels; do
		cat <<G
menuentry 'Chamesle ($k)' {
	search --no-floppy --fs-uuid --set=root $(blkid -s UUID -o value "$where")
	linux $p/vmlinuz-$k $cmdline quiet
	initrd $p/$(img $k)
}
G
	done
	exit 0
fi

disk=/dev/$(lsblk -no PKNAME "$bootdev" | head -1)
bios=1
if [ "$(lsblk -dno PTTYPE "$disk")" = gpt ] && ! lsblk -no PARTTYPE "$disk" | grep -qi 21686148-6449-6e6f-744e-656564454649; then bios=; fi
[ -z "$bios" ] && [ ! -d /sys/firmware/efi ] && die "this machine boots by BIOS and $disk is GPT with no BIOS boot partition: add a 1M one in cfdisk (type BIOS boot), or use a dos label"

if [ $loader = grub ]; then
	case $(cat "$t/etc/mag/arch" 2>/dev/null) in x86) efi=i386-efi;; *) efi=x86_64-efi;; esac
	if [ -n "$glibc" ]; then inroot mag install grub >/dev/null || die "mag install grub failed"
	else inroot mag install grub grub-efi ${bios:+grub-bios} >/dev/null || die "mag install grub failed"; fi
	inroot grub-install --target=$efi --efi-directory=/boot --boot-directory=/boot --removable --no-nvram >/dev/null || die "grub-install for UEFI failed"
	echo "UEFI: GRUB in EFI/BOOT on $bootdev"
	if [ -n "$bios" ]; then
		inroot grub-install --target=i386-pc --boot-directory=/boot "$disk" >/dev/null || die "grub-install for BIOS failed"
		echo "BIOS: GRUB is on $disk"
	else
		echo "BIOS: $disk is GPT with no BIOS boot partition, so it boots by UEFI only"
	fi
	c=$t/boot/grub/grub.cfg
	[ -e "$c" ] && mv "$c" "$c.old" && echo "the old grub.cfg is grub.cfg.old"
	{
		echo "set timeout=3"
		for k in $kernels; do
			printf "\nmenuentry 'Chamesle (%s)' {\n\tsearch --no-floppy --fs-uuid --set=root %s\n" "$k" "$(blkid -s UUID -o value "$bootdev")"
			printf '\tlinux /vmlinuz-%s %s quiet\n\tinitrd /%s\n}\n' "$k" "$cmdline" "$(img $k)"
		done
	} > "$c"
	cat "$c"
	exit 0
fi

[ -e "$t/usr/share/limine/limine-bios.sys" ] || inroot mag install limine || die "mag install limine failed"

c=$t/boot/limine.conf
[ -e "$c" ] && mv "$c" "$c.old" && echo "the old limine.conf is limine.conf.old"
{
	echo "timeout: 3"
	for k in $kernels; do
		printf '\n/Chamesle (%s)\n    protocol: linux\n    path: boot():/vmlinuz-%s\n' "$k" "$k"
		printf '    module_path: boot():/%s\n    cmdline: %s quiet\n' "$(img $k)" "$cmdline"
	done
} > "$c"
cat "$c"
echo

mkdir -p "$t/boot/EFI/BOOT"
for e in BOOTX64.EFI BOOTIA32.EFI; do [ -e "$t/usr/share/limine/$e" ] && cp "$t/usr/share/limine/$e" "$t/boot/EFI/BOOT/"; done
echo "UEFI: EFI/BOOT on $bootdev"

cp "$t/usr/share/limine/limine-bios.sys" "$t/boot/"
if [ -z "$bios" ]; then
	echo "BIOS: $disk is GPT with no BIOS boot partition, so it boots by UEFI only"
else
	# on GPT, stage 2 goes in the BIOS boot partition: limine wants its number
	n=$(lsblk -lno NAME,PARTTYPE "$disk" | awk 'tolower($2) == "21686148-6449-6e6f-744e-656564454649" { print $1 }' | head -n 1 | sed 's/.*[^0-9]//')
	inroot limine bios-install "$disk" $n || die "limine bios-install $disk $n failed"
	echo "BIOS: limine is on $disk"
fi
