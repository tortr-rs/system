#!/bin/sh
# chamesle-chroot DIR [COMMAND...]: chroot into DIR with /proc, /sys, /dev and /run in place, and take them away again afterwards.
#   chamesle-chroot /mnt
#   chamesle-chroot /mnt mag install vim
[ $# -ge 1 ] || { echo "usage: chamesle-chroot DIR [COMMAND...]" >&2; exit 2; }
dir=$1
shift
[ -d "$dir" ] || { echo "chamesle-chroot: $dir is not a directory" >&2; exit 1; }
[ "$(id -u)" = 0 ] || { echo "chamesle-chroot: needs root" >&2; exit 1; }
[ $# -gt 0 ] || set -- /bin/mksh -l

mounted=
cleanup() {
	for m in $mounted; do umount "$dir/$m" 2>/dev/null || umount -l "$dir/$m"; done
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

# mnt PLACE MOUNT-ARGS...: mounts on $dir/PLACE, remembering it so cleanup undoes the last one first
mnt() {
	place=$1
	shift
	mkdir -p "$dir/$place"
	mount "$@" "$dir/$place" || { echo "chamesle-chroot: cannot mount $dir/$place" >&2; exit 1; }
	mounted="$place $mounted"
}

mnt proc -t proc proc
mnt sys -t sysfs sysfs
mnt dev --bind /dev
mnt dev/pts --bind /dev/pts
mnt run -t tmpfs tmpfs
[ -f /etc/resolv.conf ] && cp /etc/resolv.conf "$dir/etc/resolv.conf"
env -i HOME=/root TERM="${TERM:-linux}" PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin chroot "$dir" "$@"
