#!/bin/sh
# chamesle-bootstrap TARGET [PACKAGE]...: puts the Chamesle base into TARGET with mag, like debootstrap does for Debian.
# the repos and the keys are this system's, from /etc/mag. the base is chamesle-base, a kernel and what they need.
#   chamesle-bootstrap /mnt
#   chamesle-bootstrap -a x86 -n box /mnt vim
set -e
usage() {
	echo "usage: chamesle-bootstrap [-a ARCH] [-n HOSTNAME] [-k KERNEL] [-f FIRMWARE] TARGET [PACKAGE]..." >&2
	echo "  -a  x86_64, x86 and so on (default: this machine's)" >&2
	echo "  -n  host name of the new system (default chamesle)" >&2
	echo "  -k  the kernel package (default linux-lts), -f its firmware (default linux-firmware-none)" >&2
	exit 2
}
arch= name=chamesle kernel=linux-lts firmware=linux-firmware-none
while getopts a:n:k:f: o; do
	case $o in
	a) arch=$OPTARG;;
	n) name=$OPTARG;;
	k) kernel=$OPTARG;;
	f) firmware=$OPTARG;;
	*) usage;;
	esac
done
shift $((OPTIND - 1))
[ $# -ge 1 ] || usage
target=$1
shift
[ "$(id -u)" = 0 ] || { echo "chamesle-bootstrap: run it as root" >&2; exit 1; }
command -v mag >/dev/null || { echo "chamesle-bootstrap: mag is not in PATH" >&2; exit 1; }
[ -f /etc/mag/repos ] && [ -d /etc/mag/keys ] || { echo "chamesle-bootstrap: /etc/mag/repos and /etc/mag/keys are needed" >&2; exit 1; }

mkdir -p "$target/etc/mag" "$target/dev" "$target/proc" "$target/sys" "$target/run" "$target/tmp" "$target/boot"
chmod 1777 "$target/tmp"
cp /etc/mag/repos "$target/etc/mag/repos"
cp -R /etc/mag/keys "$target/etc/mag/"
[ -n "$arch" ] && echo "$arch" > "$target/etc/mag/arch"
export MAG_ROOT=$target
mag update
# the kernel wants some firmware; the vendor packages do not count as that, so -none goes with them
case $firmware in linux-firmware|linux-firmware-none) ;; *) firmware="linux-firmware-none $firmware";; esac
mag install chamesle-base $firmware $kernel "$@"
echo "$name" > "$target/etc/hostname"
[ -e "$target/etc/resolv.conf" ] || cp /etc/resolv.conf "$target/etc/" 2>/dev/null || :
echo
echo "the base is in $target. go on with the fstab, a password and the boot entry (handbook, 3.4)."
