#!/bin/sh
# Winchester's init.conf: its host name to /etc/hostname, the rest is read by post-upgrade
[ -f /etc/init.conf ] || exit 0
h=$(sed -n 's/^hostname *= *//p' /etc/init.conf)
[ -n "$h" ] && { [ ! -s /etc/hostname ] || [ "$(cat /etc/hostname)" = localhost ]; } && echo "$h" > /etc/hostname
cp /etc/init.conf /etc/init.conf.old
exit 0
