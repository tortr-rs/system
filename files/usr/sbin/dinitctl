#!/bin/sh
# dinitctl for the system's dinit. someone who is not root goes through doas, and where dinit is not running (a chroot,
# a system being installed) enable and disable work on the files. -u or --user is left to a user's own dinit
for a; do case $a in -u|--user|-p|--socket-path) exec /usr/bin/dinitctl "$@";; esac; done
[ "$(id -u)" = 0 ] || exec doas /usr/bin/dinitctl "$@"
if [ ! -S /run/dinitctl ]; then
	for a; do
		case $a in
		enable|disable) exec /usr/bin/dinitctl --offline "$@";;
		-*) ;;
		*) echo "dinitctl: dinit is not running here, only enable and disable work" >&2; exit 1;;
		esac
	done
fi
exec /usr/bin/dinitctl "$@"
