#!/bin/sh
# install [PREFIX]: puts the desktop in PREFIX (/usr/local), with DESTDIR in front if it is set
set -e
cd "$(dirname "$0")"
p=$DESTDIR${1:-/usr/local}
s=$p/share/slate
mkdir -p "$p/bin" "$s"
install -m755 bin/slate "$p/bin/"
for f in WindowMaker WMState WMRootMenu WMWindowAttributes; do install -m644 "share/$f" "$s/"; done
install -m755 share/autostart share/web share/exit "$s/"
install -m644 share/tint2rc share/dunstrc "$s/"
mkdir -p "$s/xdm"
install -m644 share/xdm/Xresources share/xdm/Xservers "$s/xdm/"
install -m755 share/xdm/Xsetup share/xdm/Xsession "$s/xdm/"
sed "s|@SHARE@|${1:-/usr/local}/share/slate|g" share/xdm/xdm-config > "$s/xdm/xdm-config"
x=$DESTDIR/usr/share/xsessions
mkdir -p "$x"
printf '[Desktop Entry]\nName=Slate\nComment=Window Maker with the dock apps and the NeXT look\nExec=%s/bin/slate\nType=Application\n' "${1:-/usr/local}" > "$x/slate.desktop"
