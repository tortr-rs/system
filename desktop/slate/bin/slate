#!/bin/sh
# slate: Window Maker with the dock apps and the NeXT look. startx slate, or pick it in a display manager.
# the first time, and when slate brings a new dock or menu, it puts its look, dock and menu in ~/GNUstep (what was
# there first goes to *.before); in between they are yours to change in WPrefs. SLATE_RESET=1 puts them back.
# ~/GNUstep names no path, so one home runs it from /usr and from /usr/local: "slate autostart" and "slate web"
s=${SLATE_SHARE:-$(dirname "$(dirname "$(readlink -f "$0")")")/share/slate}
v=2
case $1 in autostart|web) f=$s/$1; shift; exec "$f" "$@";; esac
g=$HOME/GNUstep
export XDG_CURRENT_DESKTOP=WindowMaker XDG_SESSION_DESKTOP=WindowMaker
if [ "$(cat "$g/.slate" 2>/dev/null)" != $v ] || [ -n "$SLATE_RESET" ]; then
	mkdir -p "$g/Defaults" "$g/Library/WindowMaker"
	for f in WindowMaker WMState WMRootMenu WMWindowAttributes; do
		[ -e "$g/Defaults/$f" ] && [ ! -e "$g/Defaults/$f.before" ] && mv "$g/Defaults/$f" "$g/Defaults/$f.before"
		cp "$s/$f" "$g/Defaults/$f"
	done
	a=$g/Library/WindowMaker/autostart
	[ -e "$a" ] && [ ! -e "$a.before" ] && mv "$a" "$a.before"
	printf '#!/bin/sh\nexec slate autostart\n' > "$a"
	chmod 755 "$a"
	echo $v > "$g/.slate"
fi
exec wmaker "$@"
