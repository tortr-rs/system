#!/bin/sh
# service -l | -e | name start|stop|restart|status
. /etc/init.sh
dirs="/etc/rc.d /usr/local/etc/rc.d"
find_script() {
	for d in $dirs; do
		[ -x "$d/$1" ] && { echo "$d/$1"; return 0; }
	done
	return 1
}
case $1 in
-l)
	for d in $dirs; do
		for f in $d/*; do [ -x "$f" ] && echo "${f##*/}"; done
	done;;
-e)
	for s in $(conf boot-services); do
		find_script "$s" || echo "service: $s: no such service" >&2
	done;;
-*|'') echo "usage: service -l | -e | name start|stop|restart|status" >&2; exit 2;;
*)
	s=$(find_script "$1") || { echo "service: $1: no such service" >&2; exit 1; }
	shift
	exec "$s" "$@";;
esac
