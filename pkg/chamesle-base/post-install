#!/bin/sh
cat > /etc/motd <<M
Chamesle. The handbook is /usr/share/doc/chamesle/handbook.md, mag help says how to get more.

M
sed -i 's|^root:\([^:]*\):0:0:\([^:]*\):/root:/bin/sh$|root:\1:0:0:\2:/root:/bin/mksh|' /etc/passwd
grep -qx /bin/mksh /etc/shells || echo /bin/mksh >> /etc/shells
mkdir -p /etc/dinit.d/boot.d
exit 0
