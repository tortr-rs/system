#!/bin/sh
# getty TTY: a login on TTY. a serial port the machine does not have gets no getty, instead of one failing over and over
t=$1
shift
case $t in
ttyS*)
	grep -q "^${t#ttyS}: uart:unknown" /proc/tty/driver/serial 2>/dev/null && exec sleep 2147483647
	exec /sbin/agetty "$@" -L $t 115200 vt100;;
*) exec /sbin/agetty "$@" --noclear $t linux;;
esac
