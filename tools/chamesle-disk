#!/bin/sh
# chamesle-disk DISK: erases a disk and sets it up for Chamesle: you lay out the partitions in cfdisk, then the boot partition becomes
# vfat and the root partition a ZFS pool, both mounted under /mnt with a fstab written. the install itself stays by hand, see the handbook.
#   chamesle-disk /dev/nvme0n1
die() { echo "chamesle-disk: $*" >&2; exit 1; }
[ $# = 1 ] || { echo "usage: chamesle-disk DISK" >&2; exit 2; }
[ "$(id -u)" = 0 ] || die "needs root"
disk=$1
[ -b "$disk" ] || die "$disk is not a block device"
for t in cfdisk mkfs.fat zpool zfs blkid lsblk; do command -v $t >/dev/null || die "$t is not installed"; done
mountpoint -q /mnt && die "/mnt is in use, unmount it first"
zpool list rpool >/dev/null 2>&1 && die "a pool called rpool is already imported (zpool export -f rpool to let go of it)"

lsblk "$disk"
echo "Everything on $disk will be erased."
printf 'Type the name of the disk (%s) to go on: ' "${disk##*/}"
read -r answer
[ "$answer" = "${disk##*/}" ] || [ "$answer" = "$disk" ] || die "not confirmed, nothing was changed"

cfdisk "$disk" || die "cfdisk failed"
sleep 1
echo
lsblk "$disk"

# part WHAT: asks for a partition of the disk, takes sda1 as well as /dev/sda1
part() {
	printf '%s: ' "$1" >&2
	read -r p
	case $p in /dev/*) ;; *) p=/dev/$p;; esac
	[ -b "$p" ] || die "$p is not a block device"
	case $p in "$disk"?*) ;; *) die "$p is not a partition of $disk";; esac
	echo "$p"
}
boot=$(part "Which partition is the boot partition (vfat, the EFI system partition)") || exit 1
root=$(part "Which partition is the root (ZFS)") || exit 1
[ "$boot" != "$root" ] || die "boot and root cannot be the same partition"

[ -e /dev/zfs ] || modprobe zfs || die "the zfs module is not there"
modprobe vfat; modprobe nls_utf8
mkfs.fat -F32 "$boot" || die "mkfs.fat failed"
undo() { umount /mnt/boot 2>/dev/null; zpool export -f rpool 2>/dev/null; die "$1, rpool was exported again, run chamesle-disk again"; }
zpool create -f -o ashift=12 -O compression=zstd -O acltype=posixacl -O xattr=sa -O mountpoint=none -R /mnt rpool "$root" || die "zpool create failed"
zfs create -o mountpoint=/ -o canmount=noauto rpool/root || undo "zfs create failed"
zfs create -o mountpoint=/home rpool/home
zfs create -o mountpoint=/var rpool/var
zpool set bootfs=rpool/root rpool
zfs mount rpool/root || undo "cannot mount rpool/root"
zfs mount -a
mkdir -p /mnt/boot /mnt/etc
mount -t vfat "$boot" /mnt/boot || undo "cannot mount $boot"

if [ -e /mnt/etc/fstab ]; then
	echo "/mnt/etc/fstab is there already, left alone"
else
	cat > /mnt/etc/fstab <<F
# the zfs datasets mount themselves, so they are not listed here
# device  mount  type  options  dump pass
UUID=$(blkid -s UUID -o value "$boot") /boot vfat rw,noatime 0 2
proc /proc proc defaults 0 0
sysfs /sys sysfs defaults 0 0
tmpfs /tmp tmpfs mode=1777 0 0
F
fi

cat <<N

$boot is vfat and mounted on /mnt/boot, the pool rpool is on $root and mounted on /mnt.
Now install the system into /mnt, then limine.conf, the host name and a password: chapter 3 of the handbook,
section 3.3 onwards (cat /usr/share/doc/chamesle/handbook.md).
N
